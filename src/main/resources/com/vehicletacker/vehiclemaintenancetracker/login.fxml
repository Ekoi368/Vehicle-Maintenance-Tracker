<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vehicletacker.vehiclemaintenancetracker.controller.LoginController">
   <children>
      <Label layoutX="63.0" layoutY="38.0" prefHeight="44.0" prefWidth="548.0" text="Vehicle Maintenance Tracker">
         <font>
            <Font name="System Bold Italic" size="39.0" />
         </font>
      </Label>
      <TextField fx:id="usernameField" layoutX="187.0" layoutY="192.0" prefHeight="49.0" prefWidth="347.0" promptText="enter your username">
         <font>
            <Font size="26.0" />
         </font>
      </TextField>
      <Label layoutX="14.0" layoutY="197.0" prefHeight="34.0" prefWidth="171.0" text="Username">
         <font>
            <Font name="System Italic" size="31.0" />
         </font>
      </Label>
      <Label layoutX="14.0" layoutY="267.0" prefHeight="34.0" prefWidth="171.0" text="Password">
         <font>
            <Font name="System Italic" size="30.0" />
         </font>
      </Label>
      <PasswordField fx:id="passwordField" layoutX="187.0" layoutY="262.0" prefHeight="49.0" prefWidth="347.0" promptText="enter your password">
         <font>
            <Font size="27.0" />
         </font>
      </PasswordField>
      <Button layoutX="222.0" layoutY="365.0" mnemonicParsing="false" onAction="#handleLogin" prefHeight="25.0" prefWidth="183.0" text="Sign In" textFill="#3774b2">
         <font>
            <Font name="System Bold" size="32.0" />
         </font>
      </Button>
      <Label layoutX="222.0" layoutY="94.0" prefHeight="39.0" prefWidth="214.0" text="Login Page">
         <font>
            <Font name="System Bold Italic" size="33.0" />
         </font>
      </Label>
      <Label layoutX="117.0" layoutY="481.0" prefHeight="39.0" prefWidth="300.0" text="Don't have an account?">
         <font>
            <Font name="System Italic" size="16.0" />
         </font>
      </Label>
      <Button layoutX="286.0" layoutY="485.0" mnemonicParsing="false" onAction="#openSignUp" prefHeight="28.0" prefWidth="128.0" text="Sign Up" textFill="#2a5bbf">
         <font>
            <Font name="System Bold Italic" size="15.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
